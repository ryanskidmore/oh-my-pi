// Cloudflare Workers AI called directly (NOT through AI Gateway).
//
// Capability data is NOT restated here. `GET {account}/ai/models/search?format=openrouter`
// publishes every row's context window, per-token tariff (including the cached-input rate),
// input modalities, tool-calling flag and `reasoning_effort` vocabulary, and
// `cloudflareWorkersAiModelManagerOptions` maps all of it verbatim — including
// `reasoningDisableMode`, derived per model from whether the advertised vocabulary contains
// `none`. Only facts the endpoint does not publish, or publishes wrongly, belong in this file.
//
// Deliberately NO `discovery` node and NO `seed`: `discovery` is what enrolls a provider in
// generate-models.ts, and the Workers AI roster/tariff changes on Cloudflare's schedule, so
// baking one snapshot into models.json would ship a stale hard-coded list. Runtime discovery is
// the only source of rows, which is why `cloudflare-workers-ai` is listed in
// compat-conformance.test.ts's RUNTIME_ONLY_PROVIDERS.
//
// priority=-1: `thinking-efforts` below is a generic fallback for rows that reason
// (`supported_features` includes `reasoning`) but publish no `reasoning.supported_efforts`
// vocabulary at all (nemotron-3-120b-a12b, glm-4.7-flash, qwen3-30b-a3b-fp8, qwen3.8-27b,
// gpt-oss). A discovered ladder always wins regardless of this priority — `resolve.ts`'s
// `resolveThinkingPolicy` only reaches the cascade `rule.efforts` fallback when
// `spec.thinking` is undefined (an explicit `thinking.efforts` short-circuits straight to
// `fillExplicitThinking`, which never touches the ladder) — so this can never clobber a
// discovered ladder such as deepseek's `[low, high, max]` or kimi's `[high]`. The negative
// priority only matters for gpt-oss: `classes/gpt-oss.kdl`'s unconditioned class-root
// `thinking-efforts "low" "medium" "high"` ties with this rule at the same
// (exactness=0, dimensions=1) rank, and `-1` lets the lineage-scoped class rule win the tie
// instead of `gen:compat` throwing `AmbiguousOverlapError` (the two rules agree on the value,
// so the tie-break is cosmetic, but an explicit priority is required either way).
provider "cloudflare-workers-ai" priority=-1 {
	default-model "@cf/moonshotai/kimi-k2.7-code"
	env "CLOUDFLARE_WORKERS_AI_API_KEY" "CLOUDFLARE_API_TOKEN"
	dynamic-models-authoritative #true
	// The Workers AI row is the whole truth for this deployment. Same-id rows elsewhere — including
	// the `workers-ai/@cf/...` mirror this catalog projects onto cloudflare-ai-gateway — carry a
	// different tariff and a different effort ladder, so foreign backfills would misreport both.
	skip-cross-provider-reference-fills #true

	// Prompt caching engages only when identical requests reach the same instance. Cloudflare's
	// documented mechanism is a stable per-session `x-session-affinity` header; there is no
	// `prompt_cache_key` equivalent. Measured: cached_tokens 0 without it, 25984/26034 with it.
	prompt-cache-session-header "x-session-affinity"
	// Omitting the output cap makes the endpoint answer with its 256-token default, so a cap rides
	// every request; discovery supplies the per-row value.
	always-send-max-tokens #true
	// `role: "developer"` and `store` are accepted (HTTP 200), but this endpoint accepts every
	// unknown field it is handed, so acceptance is not evidence the semantics are honored. Both
	// stay off and system prompts ride the `system` role, matching every sibling gateway.
	supports-developer-role #false
	supports-store #false
	// Every request is validated against the served model's own JSON Schema, and five rows type
	// `messages[].content` as a string OR ONE content part: a message whose content array holds
	// two or more parts fails with HTTP 400 `AiError: Bad input: Error: oneOf at '/' not met …
	// Type mismatch of '/messages/N/content'` (code 5006). omp emits one text part per context
	// block, so an ordinary "environment preamble + question" user turn tripped it. Censused
	// 2026-09-18 on @cf/openai/gpt-oss-120b, @cf/openai/gpt-oss-20b,
	// @cf/meta/llama-3.3-70b-instruct-fp8-fast, @cf/ibm-granite/granite-4.0-h-micro and
	// @cf/qwen/qwen3-30b-a3b-fp8: a two-part array is rejected whether the sibling messages are
	// strings or arrays (so "make every message an array" is NOT a fix), a one-part array is
	// accepted, and a plain string is accepted by all 18 rows. Image parts are exempt — they
	// have no string encoding, and they only reach the multimodal rows, which accept a
	// multi-part array beside a string system prompt (verified on
	// @cf/meta/llama-4-scout-17b-16e-instruct).
	requires-string-message-content #true
	// `tool_choice: {type:"function", …}` returns 200 but the model answers with plain text instead
	// of calling the named tool (verified 2026-09-18 on @cf/zai-org/glm-4.7-flash).
	// `tool_choice: "required"` does force a call and stays enabled.
	supports-named-tool-choice #false
	// Reasoning arrives duplicated on `delta.reasoning` and `delta.reasoning_content`; the
	// transport takes the first non-empty alias, so pin the canonical field.
	reasoning-content-field "reasoning_content"
	// Reasoning depth is selected with OpenAI `reasoning_effort`, never Qwen-native thinking
	// fields. Same contract as providers/cerebras.kdl.
	thinking-mode "effort"
	// The endpoint 400s (`AiError` code 8001, "Invalid input") on `reasoning_effort: "minimal"`
	// and `"xhigh"` for rows that never advertised those tiers; the documented enum is
	// low/medium/high. Without this, ladderless reasoning rows fell back to the generic
	// five-tier scale, and because this provider's disable mode is `lowest-effort`, turning
	// thinking off sent `minimal` and failed on every request. See priority= comment above.
	thinking-efforts "low" "medium" "high"
	class "qwen" {
		thinking-format "openai"
	}
}
